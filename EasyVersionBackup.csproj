<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- SEMANTIC ANCHOR: FRAMEWORK_TARGET (SSOT). The project owns the Windows Forms target framework; publish profiles inherit it. -->
		<TargetFramework>net10.0-windows</TargetFramework>
		
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Ressources\favicon2.ico</ApplicationIcon>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>

		<Authors>Daniel Capilla</Authors>
		<Company>Daniel Capilla</Company>
		<Product>EasyVersionBackup</Product>
		<Copyright>Copyright © Daniel Capilla</Copyright>

		<Version>1.4.5</Version>
		<AssemblyVersion>1.4.5.0</AssemblyVersion>
		<FileVersion>1.4.5.0</FileVersion>
		<InformationalVersion>1.4.5</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Ressources\favicon2.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<None Remove="Settings\EasyVersionBackup.settings.json" />
		<EmbeddedResource Include="Ressources\molotov.jpg" />
		<EmbeddedResource Include="Ressources\favicon2.ico" />
		<EmbeddedResource Include="Ressources\ko-fi.png" />
        <!-- Semantic Anchor [Theme preset SSOT]: Embed the original JSON presets in the assembly;
             the selected ID is persisted in AppSettings, never in this project file. -->
        <EmbeddedResource Include="Themes\*.json" LogicalName="EasyVersionBackup.Themes.%(Filename)%(Extension)" />
	</ItemGroup>
    <!-- Semantic Anchor [Optional portable rendering library]: The host keeps its existing
         ThemeSurface, timer, UI state and settings. Reference Core for new procedural
         effects only; do not instantiate a competing WinForms animation host. -->
    <!-- Semantic Anchor [Portable library compilation / SSOT]: Each referenced subproject
         exclusively compiles its own source and generated obj files. The WinForms host must
         exclude all nested Library C# sources, including future library/test projects. -->
    <ItemGroup>
        <Compile Remove="Library\**\*.cs" />
        <ProjectReference Include="Library\PortableThemes.Core\PortableThemes.Core.csproj" />
    </ItemGroup>

</Project>